{
  "cli": {
    "version": ">= 7.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "SENTRY_DSN": "${process.env.SENTRY_DSN}"
      }
    },
    "preview": {
      "env": {
        "SENTRY_AUTH_TOKEN": "SENTRY_AUTH_TOKEN"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "SENTRY_AUTH_TOKEN": "SENTRY_AUTH_TOKEN"
      },
      "android": {
        "image": "latest"
      },
      "ios": {}
    }
  },
  "submit": {
    "production": {
      "android": {},
      "ios": {}
    }
  }
}