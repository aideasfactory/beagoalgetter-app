{
  "name": "goalgetter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "buildIosDev": "eas build --profile development --platform ios",
    "preBuild": "npx expo prebuild --clean",
    "resetAll": "rm -rf android && rm -rf ios && rm -rf node_modules",
    "buildIosLocal": "eas build --platform ios --clear-cache --local --non-interactive",
    "buildAndroidLocal": "eas build --platform android --clear-cache --local --non-interactive",
    "buildIosFileLocal": "eas build --platform ios --local",
    "buildAndroidProd": "eas build --profile production --platform android",
    "buildIosProd": "eas build --profile production --platform ios",
    "submitIosProd": "eas submit --platform ios",
    "update:production": "eas update --channel production",
    "update:staging": "eas update --channel staging",
    "update:development": "eas update --channel development",
    "lint": "expo lint",
    "remove-auth": "node scripts/remove_auth.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^5.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "^6.15.1",
    "@supabase/supabase-js": "^2.50.0",
    "axios": "^1.10.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~53.0.12",
    "expo-apple-authentication": "^7.2.4",
    "expo-auth-session": "^6.2.0",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "^0.14.6",
    "expo-clipboard": "^8.0.7",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.4",
    "expo-device": "^7.1.4",
    "expo-document-picker": "^14.0.7",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.3.0",
    "expo-image-picker": "^17.0.8",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "~7.1.5",
    "expo-localization": "^16.1.5",
    "expo-notifications": "^0.31.3",
    "expo-router": "~5.1.0",
    "expo-secure-store": "^14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-superwall": "^0.0.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.9",
    "expo-updates": "~0.28.18",
    "expo-web-browser": "~14.2.0",
    "i18next": "^25.2.1",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.5.3",
    "react-native": "0.79.4",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.15.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.10.1",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-worklets": "^0.6.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  },
  "private": true
}
